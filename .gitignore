# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# uploaded lead attachments (see ATTACHMENT_DIR)
/storage

# end-to-end test artifacts (screenshots of failures)
/tests/e2e/output

# client source documents kept locally only (requirement change notes, the legacy lead tracker with real contact data)
/docs/*.docx
/docs/*.xlsx
/import-report*.txt

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.setup.local.example
!.env.remote.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Google OAuth client downloads and service-account files must never be committed; the app reads the values from .env.local.
client_secret*.json
*credentials*.json
*service-account*.json


# local reference material shared for planning and analysis only (never part of the app)
/input
