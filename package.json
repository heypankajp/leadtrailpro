{
  "name": "salestrackpro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:create": "node --env-file=.env.setup.local scripts/create-database.mjs",
    "db:user:create": "node --env-file=.env.setup.local scripts/create-app-user.mjs",
    "db:seed": "node --env-file=.env.setup.local scripts/seed-sample-data.mjs",
    "db:import": "node --env-file=.env.setup.local scripts/import-tracker.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "jobs": "node scripts/jobs.mjs",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=120000 tests/e2e/*.test.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.13.0",
    "next": "16.4.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/webdriverjs": "^4.14.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "selenium-webdriver": "^4.51.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "argparse": "2.0.1"
  }
}
