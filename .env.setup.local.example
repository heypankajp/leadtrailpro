PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_admin_password
# Name of the restricted application role created by `npm run db:user:create` (default: salestrackpro_app).
# PGAPPUSER=salestrackpro_app
# Database name (default: salestrackpro). The scripts connect to the maintenance database "postgres" to create it.
# PGDATABASE=salestrackpro
