PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGDATABASE=leadtrailpro
PGPASSWORD=your_postgres_admin_password
# Name of the restricted application role created by `npm run db:user:create` (default: leadtrailpro_app).
# PGAPPUSER=leadtrailpro_app
# Database name (default: leadtrailpro). The scripts connect to the maintenance database "postgres" to create it.
# PGDATABASE=leadtrailpro
