MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_admin_user
MYSQL_PASSWORD=your_mysql_admin_password
# Host part of the app database account created by `npm run db:user:create` (default: MYSQL_HOST).
# Use % when the app connects from another machine or container; the Docker setup service sets this itself.
# MYSQL_APP_USER_HOST=%
